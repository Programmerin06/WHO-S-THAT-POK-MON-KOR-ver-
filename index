      document.getElementById('stat-spatk-val').textContent = stats.spatk;
      document.getElementById('stat-spatk-bar').style.width = Math.min(100, (stats.spatk / maxStatVal) * 100) + '%';

      document.getElementById('stat-spdef-val').textContent = stats.spdef;
      document.getElementById('stat-spdef-bar').style.width = Math.min(100, (stats.spdef / maxStatVal) * 100) + '%';

      document.getElementById('stat-speed-val').textContent = stats.speed;
      document.getElementById('stat-speed-bar').style.width = Math.min(100, (stats.speed / maxStatVal) * 100) + '%';

      const total = stats.hp + stats.atk + stats.def + stats.spatk + stats.spdef + stats.speed;
      document.getElementById('stat-total').textContent = `총합: ${total}`;
    }

    // Render Type Badges on Screen
    function renderTypeBadges(types) {
      elPokeTypes.innerHTML = '';
      types.forEach(t => {
        const typeKey = typeof t === 'string' ? t : t.type.name;
        const info = POKEMON_TYPES_KO[typeKey] || { name: typeKey, color: 'bg-gray-600' };
        const badge = document.createElement('span');
        badge.className = `px-2 py-0.5 text-white rounded text-xs font-bold ${info.color}`;
        badge.textContent = info.name;
        elPokeTypes.appendChild(badge);
      });
    }

    // Render Main Data to UI Screen
    function displayPokemonData(data) {
      currentPokeId = data.id;
      elPokeId.textContent = `No.${String(data.id).padStart(4, '0')}`;
      elPokeName.textContent = data.name;
      elPokeHeight.textContent = `${data.height}m`;
      elPokeWeight.textContent = `${data.weight}kg`;
      elPokeGenus.textContent = data.genus || '포켓몬';
      elPokeDesc.textContent = data.desc || '설명 정보가 없습니다.';
      elPokeImg.src = data.img;

      renderTypeBadges(data.types);
      renderStats(data.stats);
      audioSFX.playSuccess();
    }

    // Fetch Pokemon Data from PokéAPI in Korean
    async function loadPokemon(query) {
      elLoading.classList.remove('hidden');

      // Check if Offline Preset exists for Instant Display
      if (typeof query === 'number' && OFFLINE_PRESETS[query]) {
        setTimeout(() => {
          displayPokemonData(OFFLINE_PRESETS[query]);
          elLoading.classList.add('hidden');
        }, 150);
        return;
      }

      try {
        // Fetch base pokemon endpoint
        const mainRes = await fetch(`https://pokeapi.co/api/v2/pokemon/${String(query).toLowerCase().trim()}`);
        if (!mainRes.ok) throw new Error('포켓몬을 찾을 수 없습니다.');
        const mainData = await mainRes.json();

        // Fetch species endpoint for Korean name & description
        const speciesRes = await fetch(mainData.species.url);
        if (!speciesRes.ok) throw new Error('상세 종 정보를 불러올 수 없습니다.');
        const speciesData = await speciesRes.json();

        // Find Korean Name
        const koNameObj = speciesData.names.find(n => n.language.name === 'ko');
        const koName = koNameObj ? koNameObj.name : mainData.name;

        // Find Korean Genus (분류)
        const koGenusObj = speciesData.genera.find(g => g.language.name === 'ko');
        const koGenus = koGenusObj ? koGenusObj.genus : '포켓몬';

        // Find Korean Flavor Text Description
        const koFlavorObj = speciesData.flavor_text_entries.reverse().find(f => f.language.name === 'ko');
        const koDesc = koFlavorObj 
          ? koFlavorObj.flavor_text.replace(/[\f\n\r]/g, ' ') 
          : '한글 도감 설명이 제공되지 않는 포켓몬입니다.';

        // Format Image
        const imgUrl = mainData.sprites.other['official-artwork'].front_default 
          || mainData.sprites.front_default;

        // Format Base Stats
        const statsObj = {
          hp: mainData.stats[0].base_stat,
          atk: mainData.stats[1].base_stat,
          def: mainData.stats[2].base_stat,
          spatk: mainData.stats[3].base_stat,
          spdef: mainData.stats[4].base_stat,
          speed: mainData.stats[5].base_stat
        };

        const formattedData = {
          id: mainData.id,
          name: koName,
          genus: koGenus,
          height: mainData.height / 10, // decimeters to meters
          weight: mainData.weight / 10, // hectograms to kg
          types: mainData.types.map(t => t.type.name),
          desc: koDesc,
          img: imgUrl,
          stats: statsObj
        };

        displayPokemonData(formattedData);

      } catch (err) {
        showToast(err.message || '포켓몬 정보 로딩 실패!');
        audioSFX.playBeep(200, 'sawtooth', 0.2);
      } finally {
        elLoading.classList.add('hidden');
      }
    }

    // Event Listeners for Navigation & Controls
    document.getElementById('btn-prev').addEventListener('click', () => {
      audioSFX.playBeep(450);
      if (currentPokeId > 1) {
        loadPokemon(currentPokeId - 1);
      } else {
        showToast('첫 번째 포켓몬입니다.');
      }
    });

    document.getElementById('btn-next').addEventListener('click', () => {
      audioSFX.playBeep(450);
      loadPokemon(currentPokeId + 1);
    });

    document.getElementById('btn-random').addEventListener('click', () => {
      audioSFX.playBeep(600);
      const randomId = Math.floor(Math.random() * 1010) + 1; // Gen 1-9 scope
      loadPokemon(randomId);
    });

    document.getElementById('search-btn').addEventListener('click', () => {
      const q = elSearchInput.value.trim();
      if (q) {
        audioSFX.playBeep(550);
        loadPokemon(q);
      } else {
        showToast('검색어를 입력해 주세요.');
      }
    });

    elSearchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        document.getElementById('search-btn').click();
      }
    });

    // D-Pad Keyboard Arrow Controls
    document.getElementById('btn-up').addEventListener('click', () => {
      audioSFX.playBeep(480);
      loadPokemon(currentPokeId + 10);
    });
    document.getElementById('btn-down').addEventListener('click', () => {
      audioSFX.playBeep(480);
      if (currentPokeId > 10) loadPokemon(currentPokeId - 10);
    });
    document.getElementById('btn-left').addEventListener('click', () => {
      document.getElementById('btn-prev').click();
    });
    document.getElementById('btn-right').addEventListener('click', () => {
      document.getElementById('btn-next').click();
    });

    document.getElementById('speaker-btn').addEventListener('click', () => {
      audioSFX.enabled = !audioSFX.enabled;
      showToast(audioSFX.enabled ? '사운드 효과 키기' : '사운드 효과 끄기');
    });

    // On Page Load Initialization
    window.onload = () => {
      initTypeFilters();
      loadPokemon(1); // Load Bulbasaur (이상해씨) default
    };
  </script>
</body>
</html>
