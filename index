  <style>
    body {
      font-family: 'Noto Sans KR', sans-serif;
      background-color: #1a1a2e;
      color: #333;
      user-select: none;
    }
    
    .pixel-font {
      font-family: 'Press Start 2P', 'Noto Sans KR', cursive;
    }

    /* Pokédex Chassis Metallic Red Gradient */
    .pokedex-body {
      background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
      box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.3), 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    /* Screen Glass Inner Shadow & Scanline Effect */
    .screen-glass {
      background: #22c55e;
      background: linear-gradient(180deg, #86efac 0%, #4ade80 100%);
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 0 10px rgba(0,0,0,0.4);
    }

    .screen-glass::before {
      content: " ";
      display: block;
      position: absolute;
      top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%);
      background-size: 100% 4px;
      z-index: 2;
      pointer-events: none;
    }

    /* Custom Scrollbar for Screen */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #15803d;
      border-radius: 4px;
    }

    /* LED Lights Pulse Effect */
    @keyframes pulse-fast {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .light-blink {
      animation: pulse-fast 1.2s infinite;
    }

    /* Retro D-Pad Button Styling */
    .d-pad-btn {
      background-color: #374151;
      box-shadow: 0 4px 0 #1f2937;
      transition: all 0.1s ease;
    }
    .d-pad-btn:active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 #1f2937;
    }

    /* Stat Bar Animation */
    .stat-bar-fill {
      transition: width 0.6s ease-in-out;
    }
  </style>
</head>
